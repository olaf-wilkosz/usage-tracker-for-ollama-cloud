{
  "manifest_version": 3,
  "name": "Usage Tracker for Ollama Cloud",
  "version": "1.2.0",
  "description": "Unofficial usage tracker for Ollama Cloud: credits, models and activity at a glance. No telemetry. Not affiliated with Ollama.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Usage Tracker for Ollama Cloud"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://ollama.com/api/*"
  ],
  "minimum_chrome_version": "121",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      },
      "description": "Open the usage popup"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "usage-tracker-for-ollama-cloud@olaf-wilkosz.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  }
}
