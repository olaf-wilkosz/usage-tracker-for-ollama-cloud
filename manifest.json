{
  "manifest_version": 3,
  "name": "Ollama Cloud Usage Tracker",
  "version": "1.1.0",
  "description": "Track your Ollama Cloud usage, credits and models at a glance. Privacy-first: no telemetry, no external servers, all data stays local.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ollama Cloud Usage Tracker"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://ollama.com/*"
  ],
  "minimum_chrome_version": "110"
}