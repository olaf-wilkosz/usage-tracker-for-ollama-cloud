    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview-server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "render": "node scripts/render-store.mjs",
    "site": "node scripts/build-site.mjs",
    "probe": "node scripts/api-probe.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
